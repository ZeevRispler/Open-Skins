{
  "name": "open-skins",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Lightweight coding workspace with OpenHands and OpenCode adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeevRispler/Open-Skins.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "make-i18n": "node scripts/make-i18n.mjs",
    "predev": "npm run make-i18n",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run make-i18n",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/serve.mjs",
    "pretest": "npm run make-i18n",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "npm run make-i18n && tsc --noEmit && eslint src tests scripts --max-warnings=0",
    "format": "prettier --write src tests scripts docs README.md",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@openhands/typescript-client": "1.54.0",
    "@opencode-ai/sdk": "1.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.25.0",
    "zustand": "5.0.14",
    "i18next": "26.4.2",
    "react-i18next": "17.0.14",
    "http-proxy": "1.18.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.0",
    "jsdom": "30.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.2.0",
    "@playwright/test": "1.58.2",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.67.0",
    "globals": "16.5.0",
    "prettier": "3.8.3"
  }
}
